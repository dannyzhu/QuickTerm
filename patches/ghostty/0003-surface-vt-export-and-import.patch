+test "export_vt round-trips the last history rows and colours" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var t = try Terminal.init(alloc, .{ .cols = 20, .rows = 3 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+
+    // Three rows of history (hist1..hist3) and three rows on screen.
+    try s.nextSlice("hist1\r\nhist2\r\nhist3\r\nscr1\r\nscr2\r\n\x1b[31mERR\x1b[0m");
+
+    const output = (try primaryScreenVtAlloc(alloc, &t, 2)).?;
+    defer alloc.free(output);
+
+    // Feed it into a fresh terminal as program output.
+    var t2 = try Terminal.init(alloc, .{ .cols = 20, .rows = 10 });
+    defer t2.deinit(alloc);
+    var s2 = t2.vtStream();
+    defer s2.deinit();
+    try s2.nextSlice(output);
+
+    const text = try t2.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+    defer alloc.free(text);
+    try testing.expectEqualStrings("hist2\nhist3\nscr1\nscr2\nERR", text);
+
+    const e = t2.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 4 } }).?;
+    try testing.expectEqual(@as(u21, 'E'), e.cell.content.codepoint);
+    try testing.expect(e.style().fg_color.eql(.{ .palette = 1 }));
+}
+
+test "export_vt takes all history when it is shorter than the limit" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var t = try Terminal.init(alloc, .{ .cols = 20, .rows = 2 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    try s.nextSlice("hist1\r\nscr1\r\nscr2");
+
+    const output = (try primaryScreenVtAlloc(alloc, &t, 100)).?;
+    defer alloc.free(output);
+    try testing.expectEqualStrings("hist1\r\nscr1\r\nscr2", output);
+}
+
+test "export_vt returns null on the alternate screen" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var t = try Terminal.init(alloc, .{ .cols = 20, .rows = 3 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    try s.nextSlice("shell output\r\n\x1b[?1049hfull-screen app");
+
+    try testing.expect(try primaryScreenVtAlloc(alloc, &t, 100) == null);
+}
