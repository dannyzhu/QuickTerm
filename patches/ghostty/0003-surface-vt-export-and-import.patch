+/// Format the primary screen as VT: the last `max_lines` rows of history
+/// followed by the active area, soft-wrapped lines unwrapped. Colors are
+/// emitted as palette indexes (not resolved to RGB) and no default fg/bg
+/// sequences are emitted, so the output takes on the palette of whatever
+/// terminal it is fed into. Returns null if the alternate screen is active.
+/// The caller owns the returned memory.
+pub fn primaryScreenVtAlloc(
+    alloc: Allocator,
+    t: *const Terminal,
+    max_lines: usize,
+) std.Io.Writer.Error!?[:0]u8 {
+    if (t.screens.active_key == .alternate) return null;
+    const screen = t.screens.active;
+    const pages = &screen.pages;
+
+    const active_tl = pages.getTopLeft(.active);
+    const tl = switch (active_tl.upOverflow(max_lines)) {
+        .offset => |pin| pin,
+        .overflow => pages.getTopLeft(.screen),
+    };
+    const br = pages.getBottomRight(.screen).?;
+
+    var builder: std.Io.Writer.Allocating = .init(alloc);
+    defer builder.deinit();
+
+    var formatter: ScreenFormatter = .init(screen, .{
+        .emit = .vt,
+        .unwrap = true,
+        .trim = false,
+    });
+    formatter.content = .{ .selection = Selection.init(tl, br, false) };
+    try formatter.format(&builder.writer);
+
+    return builder.toOwnedSliceSentinel(0) catch return error.WriteFailed;
+}
