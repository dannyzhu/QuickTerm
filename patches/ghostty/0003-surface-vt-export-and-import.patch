+    /// Export the primary screen as VT (SGR styles, `\r\n` newlines): the
+    /// last `max_lines` rows of scrollback plus the active area. Returns
+    /// false, leaving `result` untouched, when the alternate screen is
+    /// active or on error. Free the result with ghostty_surface_free_text.
+    export fn ghostty_surface_export_vt(
+        surface: *Surface,
+        max_lines: u32,
+        result: *Text,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const vt = terminal.formatter.primaryScreenVtAlloc(
+            global.alloc,
+            &core_surface.io.terminal,
+            max_lines,
+        ) catch |err| {
+            log.warn("error exporting screen as vt err={}", .{err});
+            return false;
+        } orelse return false;
+
+        result.* = .{
+            .tl_px_x = -1,
+            .tl_px_y = -1,
+            .offset_start = 0,
+            .offset_len = 0,
+            .text = vt.ptr,
+            .text_len = vt.len,
+        };
+        return true;
+    }
+
+    /// Feed bytes into the surface's terminal as if the program running in
+    /// it had written them (the pty output path, not input to the pty).
+    export fn ghostty_surface_import_output(
+        surface: *Surface,
+        ptr: [*]const u8,
+        len: usize,
+    ) void {
+        surface.core_surface.io.processOutput(ptr[0..len]);
+    }
