+test "OSC 7501: the stream dispatches queries and valid reports only" {
+    // The stream's C value union cannot be built for the C ABI (it holds
+    // the semantic prompt command), so this runs in the Zig build only.
+    if (comptime @import("terminal_options").c_abi) return error.SkipZigTest;
+
+    const testing = std.testing;
+    const stream = @import("../../stream.zig");
+
+    const H = struct {
+        queries: std.ArrayListUnmanaged(Terminator) = .empty,
+        states: std.ArrayListUnmanaged(State) = .empty,
+
+        pub fn vt(
+            self: *@This(),
+            comptime action: stream.Action.Tag,
+            value: stream.Action.Value(action),
+        ) !void {
+            switch (action) {
+                .program_status => switch (value) {
+                    .query => |t| try self.queries.append(testing.allocator, t),
+                    .report => |r| try self.states.append(testing.allocator, r.state),
+                },
+                else => {},
+            }
+        }
+
+        pub fn deinit(self: *@This()) void {
+            self.queries.deinit(testing.allocator);
+            self.states.deinit(testing.allocator);
+        }
+    };
+
+    var s: stream.Stream(H) = .initAlloc(testing.allocator, .{});
+    defer s.deinit();
+
+    try s.nextSlice("\x1b]7501;?\x1b\\");
+    try s.nextSlice("\x1b]7501;?\x07");
+    try s.nextSlice("\x1b]7501;state=working:app=cargo\x07");
+    try s.nextSlice("\x1b]7501;state=sleeping\x07");
+    try s.nextSlice("\x1b]7501;state=done:msg=Gw==\x1b\\");
+    try s.nextSlice("\x1b]7501;state=blocked:kind=question\x1b\\");
+
+    try testing.expectEqualSlices(Terminator, &.{ .st, .bel }, s.handler.queries.items);
+    try testing.expectEqualSlices(State, &.{ .working, .blocked }, s.handler.states.items);
+}
