+test "OSC 7501: discarded reports" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+
+    // 192 bytes of title and 2048 bytes of message are the most allowed.
+    // "QUFB" decodes to "AAA" and "QUE" to "AA".
+    @setEvalBranchQuota(4096);
+    const title: [max_title_encoded_bytes]u8 = std.simd.repeat(max_title_encoded_bytes, "QUFB".*);
+    const main: [max_msg_bytes / 3 * 4]u8 = std.simd.repeat(max_msg_bytes / 3 * 4, "QUFB".*);
+    const msg = main ++ "QUE";
+    const fill = max_sequence_bytes - "\x1b]7501;state=idle:".len - "\x1b\\".len;
+
+    const cases = [_]struct { []const u8, bool }{
+        // A missing or unknown state.
+        .{ "7501;", false },
+        .{ "7501;app=cargo", false },
+        .{ "7501;state=sleeping", false },
+        .{ "7501;state=", false },
+        .{ "7501;state=IDLE", false },
+
+        // A key of 16 bytes is fine, 17 is too long, even one we don't know.
+        .{ "7501;state=idle:" ++ @as([max_key_bytes]u8, @splat('a')) ++ "=1", true },
+        .{ "7501;state=idle:" ++ @as([max_key_bytes + 1]u8, @splat('a')) ++ "=1", false },
+
+        // An app of 32 bytes is fine, 33 is too long, even if a later
+        // pair replaces it.
+        .{ "7501;state=idle:app=" ++ @as([max_app_bytes]u8, @splat('a')), true },
+        .{ "7501;state=idle:app=" ++ @as([max_app_bytes + 1]u8, @splat('a')), false },
+        .{ "7501;state=idle:app=" ++ @as([max_app_bytes + 1]u8, @splat('a')) ++ ":app=ok", false },
+
+        // Title: 256 encoded / 192 decoded is the most. 257 encoded is
+        // too long. A title decoding to 193 or more bytes needs at least
+        // 258 encoded bytes, so it always breaks the encoded limit too
+        // (260 / 195 here).
+        .{ "7501;state=idle:title=" ++ title, true },
+        .{ "7501;state=idle:title=" ++ title ++ "Q", false },
+        .{ "7501;state=idle:title=" ++ title ++ "QUFB", false },
+
+        // Msg: 2731 encoded / 2048 decoded is accepted. 2732 encoded is
+        // within the encoded limit but decodes to 2049 bytes. 2733
+        // encoded is over the encoded limit.
+        .{ "7501;state=idle:msg=" ++ msg, true },
+        .{ "7501;state=idle:msg=" ++ main ++ "QUFB", false },
+        .{ "7501;state=idle:msg=" ++ main ++ "QUFBQ", false },
+
+        // The whole sequence, including `ESC ]` and the `ESC \`
+        // terminator: 4096 bytes is fine, 4097 is too long.
+        .{ "7501;state=idle:" ++ @as([fill]u8, @splat('x')), true },
+        .{ "7501;state=idle:" ++ @as([fill + 1]u8, @splat('x')), false },
+
+        // Numbers that only start like 7501.
+        .{ "75;state=idle", false },
+        .{ "750;state=idle", false },
+        .{ "75010;state=idle", false },
+        .{ "7501", false },
+        .{ "7502;state=idle", false },
+    };
+    for (cases) |case| {
+        try testing.expectEqual(case[1], testAccepts(&p, case[0], '\x1b'));
+    }
+
+    // The lengths the comments above claim.
+    try testing.expectEqual(@as(usize, 2731), msg.len);
+    try testing.expectEqual(@as(usize, 2732), (main ++ "QUFB").len);
+}
+
+test "OSC 7501: id limits" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+
+    // 8 parts deep is fine, 9 is too deep.
+    try testing.expect(testAccepts(&p, "7501;state=idle:id=a/b/c/d/e/f/g/h", '\x1b'));
+    try testing.expect(!testAccepts(&p, "7501;state=idle:id=a/b/c/d/e/f/g/h/i", '\x1b'));
+
+    // A part of 32 bytes is fine, 33 is too long.
+    const seg32: [32]u8 = @splat('s');
+    try testing.expect(testAccepts(&p, "7501;state=idle:id=" ++ seg32, '\x1b'));
+    try testing.expect(!testAccepts(&p, "7501;state=idle:id=" ++ seg32 ++ "s", '\x1b'));
+
+    // 128 bytes in all is fine, 129 is too long. Four 31-byte parts and
+    // slashes make 127 bytes; one more byte on the last part makes 128.
+    const seg31: [31]u8 = @splat('i');
+    const id127 = seg31 ++ "/" ++ seg31 ++ "/" ++ seg31 ++ "/" ++ seg31;
+    try testing.expectEqual(@as(usize, 127), id127.len);
+    try testing.expect(testAccepts(&p, "7501;state=idle:id=" ++ id127 ++ "i", '\x1b'));
+    try testing.expect(!testAccepts(&p, "7501;state=idle:id=" ++ id127 ++ "/ii", '\x1b'));
+    try testing.expectEqual(@as(usize, 130), (id127 ++ "/ii").len);
+    // Exactly 129 bytes: five parts.
+    const id129 = id127 ++ "/i";
+    try testing.expectEqual(@as(usize, 129), id129.len);
+    try testing.expect(!testAccepts(&p, "7501;state=idle:id=" ++ id129, '\x1b'));
+}
+
+test "OSC 7501: a long body never allocates past the limit" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+
+    for ("7501;state=idle:") |c| p.next(c);
+    for (0..max_body_bytes * 4) |_| p.next('x');
+
+    // The capture buffer is exactly the body limit and did not grow.
+    try testing.expectEqual(@as(usize, max_body_bytes), p.writer.?.buffer.len);
+    try testing.expect(p.end('\x1b') == null);
+}
+
+test "OSC 7501: reportFromBody round-trips a parsed report" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+
+    for ("7501;state=working:app=cargo:progress=40:msg=UGxhbg") |c| p.next(c);
+    const parsed = p.end('\x1b').?.program_status.report;
+
+    // A copy of the body, as the stream handler hands it to the surface.
+    var copy: [64]u8 = undefined;
+    @memcpy(copy[0..parsed.data.len], parsed.data);
+    const report = reportFromBody(copy[0..parsed.data.len]).?;
+    try testing.expectEqual(State.working, report.state);
+    try testing.expectEqualStrings("cargo", report.readOption(.app).?);
+    try testing.expectEqual(@as(u8, 40), report.readOption(.progress).?);
+
+    try testing.expect(reportFromBody("state=sleeping") == null);
+    try testing.expect(reportFromBody("state=idle:msg=Gw==") == null);
+    try testing.expect(reportFromBody("?") == null);
+    const too_long: [max_body_bytes + 1]u8 = @splat('x');
+    try testing.expect(reportFromBody(&too_long) == null);
+}
+
+test "OSC 7501: no allocator" {
+    const testing = std.testing;
+
+    var p: Parser = .init(null);
+    defer p.deinit();
+
+    for ("7501;state=working:app=cargo") |c| p.next(c);
+    const report = p.end('\x1b').?.program_status.report;
+    try testing.expectEqual(State.working, report.state);
+    try testing.expectEqualStrings("cargo", report.readOption(.app).?);
+}
