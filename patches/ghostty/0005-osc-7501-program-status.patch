+/// The foreground process group of the pty (`tcgetpgrp` on the master),
+/// or null before the pty exists, after an error, or on a platform
+/// without one. Read-only: it reads the master fd number, set once when
+/// the subprocess starts, and takes no lock, so any thread may call it.
+pub fn foregroundPgid(self: *const Exec) ?i32 {
+    if (comptime builtin.os.tag == .windows or builtin.os.tag == .ios) return null;
+    const pty = self.subprocess.pty orelse return null;
+    const pgid = Subprocess.c.tcgetpgrp(pty.master);
+    if (pgid <= 0) return null;
+    return @intCast(pgid);
+}
