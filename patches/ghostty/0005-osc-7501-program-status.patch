+test "OSC 7501: text must decode to safe UTF-8" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+
+    const invalid = [_][]const u8{
+        // Not base64.
+        "7501;state=done:msg=a",
+        "7501;state=done:msg=QQ=",
+        "7501;state=done:title=a",
+        // Bytes of the value alphabet that base64 does not use.
+        "7501;state=done:msg=a.b,",
+        // "a\nb", a control character.
+        "7501;state=done:msg=YQpi",
+        // "\x9b", a C1 control character as UTF-8.
+        "7501;state=done:msg=wps=",
+        // Invalid UTF-8.
+        "7501;state=done:msg=/w==",
+        // "\x1b", ESC, in msg and in title.
+        "7501;state=done:msg=Gw==",
+        "7501;state=done:title=Gw==",
+        // "a\x1b[31mb", an SGR sequence hidden in text.
+        "7501;state=done:msg=YRtbMzFtYg==",
+        // U+0085 (NEL), a C1 control, as UTF-8 C2 85, in msg and title.
+        "7501;state=done:msg=woU=",
+        "7501;state=done:title=woU=",
+        // U+007F, DEL.
+        "7501;state=done:title=fw==",
+        // U+0000, NUL.
+        "7501;state=done:msg=AA==",
+    };
+    for (invalid) |input| {
+        try testing.expect(!testAccepts(&p, input, '\x1b'));
+    }
+
+    // A value with bytes outside the value alphabet is a malformed pair:
+    // it is skipped, not decoded, and the report stays.
+    p.reset();
+    for ("7501;state=done:msg=!!!!") |c| p.next(c);
+    try testing.expect(p.end('\x1b').?.program_status.report.readOption(.msg) == null);
+
+    // Unicode is fine. "安全"
+    p.reset();
+    for ("7501;state=done:msg=5a6J5YWo") |c| p.next(c);
+    const report = p.end('\x1b').?.program_status.report;
+    var buf: [max_msg_bytes]u8 = undefined;
+    var msg: std.Io.Writer = .fixed(&buf);
+    try report.writeText(.msg, &msg);
+    try testing.expectEqualStrings("安全", msg.buffered());
+}
