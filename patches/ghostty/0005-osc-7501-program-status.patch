+/// Hand an OSC 7501 report to the apprt. `body` is the report body the
+/// stream handler copied out of the parser; it was validated there and is
+/// validated again here, so a report that breaks a limit never reaches
+/// the apprt. Every string is copied into a NUL-terminated buffer on the
+/// stack, so the action's strings are valid only during the callback.
+fn programStatus(self: *Surface, body: []const u8) void {
+    const ps = terminal.osc.program_status;
+    const report = ps.reportFromBody(body) orelse {
+        log.warn("dropping invalid OSC 7501 report len={d}", .{body.len});
+        return;
+    };
+
+    var id_buf: [ps.max_id_bytes + 1]u8 = undefined;
+    var app_buf: [ps.max_app_bytes + 1]u8 = undefined;
+    var title_buf: [ps.max_title_bytes + 1]u8 = undefined;
+    var msg_buf: [ps.max_msg_bytes + 1]u8 = undefined;
+
+    const value: apprt.action.ProgramStatus = .{
+        .state = @tagName(report.state),
+        .kind = if (report.readOption(.kind)) |k| @tagName(k) else "",
+        .progress = if (report.readOption(.progress)) |v| v else -1,
+        .id = copyZ(&id_buf, report.readOption(.id) orelse ""),
+        .app = copyZ(&app_buf, report.readOption(.app) orelse ""),
+        .title = textZ(report, .title, &title_buf),
+        .msg = textZ(report, .msg, &msg_buf),
+    };
+
+    _ = self.rt_app.performAction(
+        .{ .surface = self },
+        .program_status,
+        value,
+    ) catch |err| {
+        log.warn("apprt failed to handle program status err={}", .{err});
+    };
+}
+
+/// Copy `s` into `buf` with a NUL after it. The caller sizes `buf` from
+/// the parser's limit, which `s` already passed.
+fn copyZ(buf: []u8, s: []const u8) [:0]const u8 {
+    assert(s.len < buf.len);
+    @memcpy(buf[0..s.len], s);
+    buf[s.len] = 0;
+    return buf[0..s.len :0];
+}
+
+/// Decode a report's `title` or `msg` into `buf` with a NUL after it, or
+/// the empty string when the report has none.
+fn textZ(
+    report: terminal.osc.program_status.Report,
+    comptime option: terminal.osc.program_status.Option,
+    buf: []u8,
+) [:0]const u8 {
+    var writer: std.Io.Writer = .fixed(buf[0 .. buf.len - 1]);
+    report.writeText(option, &writer) catch return "";
+    const len = writer.buffered().len;
+    buf[len] = 0;
+    return buf[0..len :0];
+}
